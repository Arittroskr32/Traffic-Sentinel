[Unit]
Description=TrafficSentinel daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/TrafficSentinel
ExecStart=/opt/TrafficSentinel/venv/bin/python /opt/TrafficSentinel/main.py
Restart=always
RestartSec=3
User=root
Group=root

NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
